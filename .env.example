# Server Configuration
PORT=3000
NODE_ENV=development
JWT_SECRET=super_secret_jwt_key_example

# Database Configuration (Optional MongoDB Atlas connection; if omitted, persistent local document store is used)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# Cloudinary & Email Notifications (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
EMAIL_USER=
EMAIL_PASS=

# AI Studio injected variables
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"
